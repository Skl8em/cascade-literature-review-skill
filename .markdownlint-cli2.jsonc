{
  // The rule block lives in .markdownlint.jsonc; here: the custom rule and the scope.
  // lint/sentence-per-line.js is vendored from Skl8em/docsys
  // (src/docsys/markdownlint/sentence-per-line.js, commit c829c6e) plus the fix that
  // lets a sentence open with inline code; the fix was not yet committed upstream
  // when vendored. Same author.
  "customRules": ["./lint/sentence-per-line.js"],
  "globs": ["**/*.md"],
  "ignores": ["LICENSES/**", "dist/**", "**/node_modules/**"]
}
